{
	"name": "ai-meeting-minutes-bot",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-25",
	"vars": {
		"R2_BUCKET_NAME": "ai-meeting-minutes-recordings",
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "VOICE_CHANNEL_SESSION",
				"class_name": "VoiceChannelSession",
			},
		],
	},
	"exports": {
		"VoiceChannelSession": {
			"type": "durable-object",
			"storage": "sqlite",
		},
	},
	"observability": {
		"enabled": true,
	},
}
